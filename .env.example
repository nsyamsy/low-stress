# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya.
# `.env` tidak masuk repositori.
#
# Untuk Docker Compose, DATABASE_URL di dalam container selalu diturunkan
# dari POSTGRES_* (host `db`). Untuk pengembangan lokal di host, isi
# DATABASE_URL sendiri (mis. postgres://postgres@127.0.0.1:5432/low_stress).

# --- Wajib ---
DEPLOY_MODE=lan
# APP_ORIGIN harus sama dengan alamat yang dibuka pengguna.
# Profil lan: http://localhost:8080 (atau http://<ip-lan>:8080).
# Profil public: https://game.example.com
APP_ORIGIN=http://localhost:8080
# Minimal 32 karakter. Ganti dengan nilai acak, jangan pakai contoh ini.
SESSION_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter

# --- Database Compose ---
POSTGRES_USER=low_stress
POSTGRES_PASSWORD=low_stress
POSTGRES_DB=low_stress

# --- Opsional ---
# auto mengikuti protokol permintaan; public sebaiknya true.
COOKIE_SECURE=auto
TZ_APP=Asia/Jakarta
DEFAULT_LOCALE=auto
LOG_LEVEL=info
WEB_PORT=8080
# Port server tidak diekspos ke host; nginx meneruskan /api dan /ws.
# Hanya dipakai bila menjalankan server di host.
# HOST=0.0.0.0
# PORT=3001

# --- Profil public (Caddy) ---
# Domain yang diarahkan ke server ini. `localhost` memakai CA internal Caddy.
APP_DOMAIN=localhost

# --- Email (kosong = nonaktif) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Low Stress <no-reply@example.com>

# --- Database eksternal / pengembangan lokal di host (bukan Compose) ---
# Isi sendiri lalu hilangkan tanda # di DATABASE_URL.
# Format: postgres://<user>:<password>@<host>:<port>/<nama_db>
# Karakter khusus di password harus di-URL-encode (mis. @ menjadi %40).
# DB_HOST=
# DB_PORT=5432
# DB_USER=low_stress
# DB_PASSWORD=
# DB_NAME=low_stress
# DATABASE_URL=postgres://low_stress:GANTI_PASSWORD@HOST_DB:5432/low_stress

# --- Database Uji (khusus eksekusi tes) ---
# Nama database HARUS berakhiran '_test' demi keamanan data pengembangan.
# Siapkan database uji otomatis dengan perintah: pnpm test:db:up
# TEST_DATABASE_URL=postgres://low_stress:GANTI_PASSWORD@HOST_DB:5432/low_stress_test
