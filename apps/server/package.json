{
  "name": "@low-stress/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@low-stress/db": "workspace:*",
    "@low-stress/i18n": "workspace:*",
    "@low-stress/sdk": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
